\name{Brazil_tree}
\alias{Brazil_tree}
\docType{data}
\title{
  Phylogenetic tree for Brazil abundance data
}
\description{
  This dataset contains a phylogenetic tree spanning the 185 species
  observed in the \code{Brazil_rainforests} dataset.
}
\usage{data(Brazil_tree)}
\format{
  \code{Brazil_tree} is a phylogenetic tree stored as an R \code{phylo} object,
  containing 185 tip labels, 117 internal nodes, and 301 edges.
  The tree has the following components: \cr
  $ edge       : int [301, 2] 186 187 188 189 190 191 ... \cr
  $ edge.length: num [301] 75 146 8 6 18 10 ... \cr
  $ Nnode      : int 117 \cr
  $ node.label : chr [117] "magnoliales_to_asterales" "poales_to_asterales" ... \cr
  $ tip.label  : chr [185] "Carpotroche_brasiliensis" "Casearia_ulmifolia" "Casearia_sp2" ...
}
\keyword{datasets}


